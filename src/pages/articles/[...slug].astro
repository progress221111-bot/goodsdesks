---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Disclosure from '../../components/Disclosure.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { categoryById } from '../../data/site';
import { relatedArticles } from '../../data/related';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, related: relatedArticles(entry, articles) },
  }));
}

const { entry, related } = Astro.props;
const { Content } = await render(entry);
const cat = categoryById(entry.data.category);
const typeLabel =
  { guide: 'Guide', roundup: 'Comparison', review: 'Review' }[entry.data.type] ?? entry.data.type;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
// 比較・レビュー記事だけ本文冒頭にも開示を出す（アフィリリンクを含むため）
const hasLinks = entry.data.type !== 'guide';
---

<Base title={entry.data.title} description={entry.data.description}>
  <article class="wrap" style="padding-top:3rem">
    <p class="article-meta">
      <a href={`/${entry.data.category}/`}>{cat?.name ?? entry.data.category}</a> · {typeLabel} ·
      Published {fmt(entry.data.published)}
      {entry.data.updated && <> · Updated {fmt(entry.data.updated)}</>}
    </p>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.description}</p>

    {hasLinks && <Disclosure />}

    <div class="prose">
      <Content />
    </div>

    {related.length > 0 && (
      <section>
        <h2>Related articles</h2>
        <ul class="card-list">
          {related.map((a) => (
            <ArticleCard
              id={a.id}
              title={a.data.title}
              description={a.data.description}
              category={a.data.category}
              type={a.data.type}
              published={a.data.published}
            />
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>
